# Copia como .env solo en tu equipo. Nunca lo subas a GitHub.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Neon: pega la URL pooled (-pooler) completa; conserva sslmode=require.
DATABASE_URL=
# Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_FOLDER=valerion_catalogo
DB_POOL_MAX=5
APP_ENV=development
COOKIE_SECURE=false
SEED_DEMO=false
# Opcional: dominios separados por comas, sin https:// ni rutas.
ALLOWED_HOSTS=
# Origen canónico. En producción debe ser el HTTPS real de la tienda.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# configurar.py crea la clave aleatoria local. No compartir ni perder las claves.
DELIVERY_KEYS=
# false en el servicio con un job separado para migraciones.
AUTO_MIGRATE=true
# Cobro opcional. Si se activa, son obligatorios los tres valores.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
# Confirmaciones de pago (Gmail SMTP SSL).
SMTP_EMAIL=
SMTP_PASSWORD=
# Opcional, solo con balanceador que sobrescribe las cabeceras de IP y secreto.
EDGE_SHARED_SECRET=
# Número de proxies de confianza delante de la app (0 = ninguno). En Render: 1.
PROXY_HOPS=0
# Correo que recibe un aviso por cada pago confirmado (opcional; requiere SMTP).
NOTIFY_EMAIL=
# true para exponer /docs, /redoc y /openapi.json en producción.
API_DOCS_PUBLIC=false

# --- Correo: reintento automático y verificación ---
# El worker reintenta confirmaciones fallidas cada 2 min (por defecto: true en producción).
MAIL_WORKER=
# Exige aceptar el Aviso de Privacidad y declarar mayoría de edad (por defecto: true en producción).
REQUIRE_LEGAL_CONSENT=

# --- Datos para las páginas legales (/privacidad, /terminos, /envios-devoluciones) ---
# Mientras falten, las páginas muestran «[COMPLETAR]». Revisa los textos con un abogado.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_RFC=
LEGAL_COVERAGE=
LEGAL_SHIPPING=
LEGAL_LEAD_TIME=
LEGAL_RETURN_WINDOW=
LEGAL_JURISDICTION=
LEGAL_PRICES_NOTE=

