# Copia como .env solo en tu equipo. Nunca lo subas a GitHub.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Neon: pega la URL pooled (-pooler) completa; conserva sslmode=require.
DATABASE_URL=
# Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_FOLDER=valerion_catalogo
DB_POOL_MAX=5
APP_ENV=development
COOKIE_SECURE=false
SEED_DEMO=false
# Opcional: dominios separados por comas, sin https:// ni rutas.
ALLOWED_HOSTS=
