# Copia como .env solo en tu equipo. Nunca lo subas a GitHub.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Neon: pega la URL pooled (-pooler) completa; conserva sslmode=require.
DATABASE_URL=
# Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_FOLDER=valerion_catalogo
DB_POOL_MAX=5
APP_ENV=development
COOKIE_SECURE=false
SEED_DEMO=false
# Opcional: dominios separados por comas, sin https:// ni rutas.
ALLOWED_HOSTS=
# Origen canónico. En producción debe ser el HTTPS real de la tienda.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# configurar.py crea la clave aleatoria local. No compartir ni perder las claves.
DELIVERY_KEYS=
# false en el servicio con un job separado para migraciones.
AUTO_MIGRATE=true
# Cobro opcional. Si se activa, son obligatorios los tres valores.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
# Confirmaciones de pago (Gmail SMTP SSL).
SMTP_EMAIL=
SMTP_PASSWORD=
# Opcional, solo con balanceador que sobrescribe las cabeceras de IP y secreto.
EDGE_SHARED_SECRET=
